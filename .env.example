# --- Database ---
DATABASE_URL=postgres://crm:crm@localhost:5432/crm

# --- App ---
APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Comma-separated. Users who sign in from these domains are auto-provisioned as reps.
ALLOWED_EMAIL_DOMAINS=outsourcelogistics.com
# Comma-separated. These users are promoted to admin on first sign-in.
ADMIN_EMAILS=
# Enables the "demo sign-in" picker on /login. Never enable in production.
AUTH_DEMO=true

# --- Microsoft Entra ID (staff SSO) ---
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# --- Microsoft Graph (shared mailbox, app-only credentials) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=quotes@outsourcelogistics.com
# Random string Graph echoes back on every notification; used to reject forged webhooks.
GRAPH_WEBHOOK_SECRET=
# Public HTTPS base URL Graph can reach. Leave blank to rely on delta polling only.
GRAPH_WEBHOOK_BASE_URL=
# "graph" for Microsoft 365, "graph-readonly" to read the inbox without sending anything,
# "fake" for local development (inbox not read; outbound is logged).
MAIL_TRANSPORT=fake

# --- OpenAI (used instead of Ollama when OPENAI_API_KEY is set) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Ollama (self-hosted open-source model) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b
